{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gt",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_line"
      }
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "blank_line"
        },
        {
          "type": "SYMBOL",
          "name": "node_line"
        },
        {
          "type": "SYMBOL",
          "name": "edge_line"
        },
        {
          "type": "SYMBOL",
          "name": "error_line"
        }
      ]
    },
    "blank_line": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\n"
      }
    },
    "node_line": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-zA-Z0-9_\\-]+( [a-zA-Z0-9_\\-]+)*\\n"
      }
    },
    "edge_line": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "    [a-zA-Z0-9_\\-]+( [a-zA-Z0-9_\\-]+)*: [a-zA-Z0-9_\\-]+( [a-zA-Z0-9_\\-]+)*\\n"
      }
    },
    "error_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\n]+\\n?"
        }
      }
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}