{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gt",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "blank_line"
              },
              {
                "type": "SYMBOL",
                "name": "error_line"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "node_line"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_line"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "blank_line"
        },
        {
          "type": "SYMBOL",
          "name": "node_line"
        },
        {
          "type": "SYMBOL",
          "name": "edge_line"
        },
        {
          "type": "SYMBOL",
          "name": "error_line"
        }
      ]
    },
    "blank_line": {
      "type": "PATTERN",
      "value": "\\n"
    },
    "node_line": {
      "type": "PREC_DYNAMIC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "node_name"
          },
          {
            "type": "PATTERN",
            "value": "\\n"
          }
        ]
      }
    },
    "edge_line": {
      "type": "PREC_DYNAMIC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "    "
          },
          {
            "type": "SYMBOL",
            "name": "edge_name"
          },
          {
            "type": "STRING",
            "value": ":"
          },
          {
            "type": "STRING",
            "value": " "
          },
          {
            "type": "SYMBOL",
            "name": "target_name"
          },
          {
            "type": "PATTERN",
            "value": "\\n"
          }
        ]
      }
    },
    "node_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9_\\-]+( [a-zA-Z0-9_\\-]+)*"
    },
    "edge_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9_\\-]+( [a-zA-Z0-9_\\-]+)*"
    },
    "target_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9_\\-]+( [a-zA-Z0-9_\\-]+)*"
    },
    "error_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\n]+\\n?"
        }
      }
    }
  },
  "extras": [],
  "conflicts": [
    [
      "node_line",
      "error_line"
    ],
    [
      "edge_line",
      "error_line"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}