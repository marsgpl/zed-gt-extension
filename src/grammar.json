{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gt",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "error_line"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "node_line"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_line"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "node_line"
        },
        {
          "type": "SYMBOL",
          "name": "edge_line"
        },
        {
          "type": "SYMBOL",
          "name": "error_line"
        }
      ]
    },
    "node_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_node_line_marker"
        },
        {
          "type": "SYMBOL",
          "name": "node_name"
        },
        {
          "type": "PATTERN",
          "value": "\\n"
        }
      ]
    },
    "edge_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_edge_line_marker"
        },
        {
          "type": "STRING",
          "value": "    "
        },
        {
          "type": "SYMBOL",
          "name": "edge_name"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "SYMBOL",
          "name": "target_name"
        },
        {
          "type": "PATTERN",
          "value": "\\n"
        }
      ]
    },
    "node_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9_\\-]+( [a-zA-Z0-9_\\-]+)*"
    },
    "edge_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9_\\-]+( [a-zA-Z0-9_\\-]+)*"
    },
    "target_name": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9_\\-]+( [a-zA-Z0-9_\\-]+)*"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_node_line_marker"
    },
    {
      "type": "SYMBOL",
      "name": "_edge_line_marker"
    },
    {
      "type": "SYMBOL",
      "name": "error_line"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}